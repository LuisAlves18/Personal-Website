<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · {{ site.nome }}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body class="antialiased">

  <input type="checkbox" id="menu-toggle" class="peer hidden">

  <header class="relative flex items-center justify-between px-6 py-4 bg-surface border-b border-line">
    <a href="{{ (lang == 'en' and '/en/' or '/') | url }}" class="font-heading font-semibold text-ink">{{ site.nome }}</a>

    <nav class="hidden md:flex gap-6 text-sm text-ink-soft">
      {% for item in (lang == 'en' and site.nav.en or site.nav.pt) %}
        <a href="{{ item.url | url }}" class="hover:text-ink">{{ item.label }}</a>
      {% endfor %}
    </nav>

    <div class="flex items-center gap-3">
      <a href="{{ site.whatsapp }}" class="bg-bordeaux text-white text-sm font-medium px-4 py-2 rounded-lg">
        {{ lang == 'en' and 'Chat on WhatsApp' or 'Falar no WhatsApp' }}
      </a>
      <label for="menu-toggle" class="md:hidden flex flex-col gap-1 cursor-pointer p-2" aria-label="{{ lang == 'en' and 'Open menu' or 'Abrir menu' }}">
        <span class="block w-5 h-0.5 bg-ink"></span>
        <span class="block w-5 h-0.5 bg-ink"></span>
        <span class="block w-5 h-0.5 bg-ink"></span>
      </label>
    </div>

    <nav class="hidden peer-checked:flex md:hidden flex-col gap-1 absolute top-full left-0 right-0 bg-surface border-b border-line px-6 py-4 text-sm text-ink-soft z-10">
      {% for item in (lang == 'en' and site.nav.en or site.nav.pt) %}
        <a href="{{ item.url | url }}" class="py-2 hover:text-ink">{{ item.label }}</a>
      {% endfor %}
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="px-6 py-8 text-center text-sm text-ink-soft border-t border-line">
    <p>{{ site.nome }} — {{ lang == 'en' and 'Shopify consulting for small businesses' or 'Consultoria Shopify para pequenos negócios' }}</p>
  </footer>

</body>
</html>
