{
  "name": "shopify-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/style.css --minify",
    "build:eleventy": "eleventy",
    "build": "npm run build:css && npm run build:eleventy",
    "dev:css": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/style.css --watch",
    "dev:eleventy": "eleventy --serve",
    "dev": "npm-run-all --parallel dev:css dev:eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.0"
  }
}
